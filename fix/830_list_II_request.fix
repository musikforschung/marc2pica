#catmandu convert CSV to Null --fix ./fix/830_list_II_request.fix < ./dictionary/830_list_II.csv

log('SRU Request', level : WARN)

copy_field(830_AC,tmp.sru)
prepend(tmp.sru,"alma.local_control_field_009=")
search_sru(tmp.sru,'https://obv-at-oenb.alma.exlibrisgroup.com/view/sru/43ACC_ONB',recordschema:marcxml,parser:marcxml)
if is_array(tmp.sru)
   do list(path:tmp.sru,var:var)
      add_to_exporter(var,PICA,type:plain,fix:./fix/marc2pica_oenb.fix,file:./data/oenb_830_II.pp)
   end
end
rm(tmp.sru)
 