@bc{AC17447237,
  abstract     = {Antonio Salieri (1750-1825) feierte als Komponist mit seinen Opern europaweit Erfolge. Als Gesangs- und Kompositionslehrer war er international begehrt. Als Hofkapellmeister prägte er lange Jahre das Musikleben Wiens. Er bildete Sänger:innen aus, brachte Franz Schubert die Grundlagen des Kontrapunkts bei und gab Beethoven den letzten Schliff in der Vokalkomposition. Was für ein Panorama - und doch denkt man bei ihm häufig nur an jenen bösartigen Gegenspieler Mozarts, der er niemals war und den erst das 19. und 20. Jahrhundert aus ihm gemacht haben. Die Beiträge des Buches korrigieren dieses Zerrbild: Sie präsentieren Salieris Wirken als Komponist, Lehrer und Organisator in all seinen Facetten.},
  abstractor   = {publisher},
  address      = {Wien},
  author       = {Böggemann, Markus},
  country      = {Austria},
  editor       = {Böggemann, Markus},
  isbn         = {9783205222118},
  keywords     = {austrian_committee},
  language     = {German},
  note         = {1, 4},
  pages        = {149},
  publisher    = {Böhlau-Verlag},
  title        = {Antonio Salieri  : Neuentdeckung eines Verkannten  : ein Lesebuch},
  type         = {bc},
  year         = {2025},
}

@bm{AC17447534,
  abstract     = {Karaoke ist mehr als nur ein Partyspaß – es ist ein weltweites Phänomen, das seit über fünf Jahrzehnten Menschen überall verbindet: ob in Kneipen, Wohnzimmern oder auf großen Bühnen. Aber wie konnte es zu der Mitsing-Manie kommen, die uns verleitet, auf musikalische oder oft sehr unmusikalische Weise unser Innerstes nach außen zu kehren? Andreas Neuenkirchen, Popkulturkenner und Japan-Experte, erzählt, wie ein musikbegeisterter (wenngleich nur durchschnittlich sangesbegabter) Ingenieur in seiner Werkstatt den Grundstein für die internationale Erfolgsgeschichte legte, wie seine Idee sich weltweit ausbreitete und warum wir Karaoke auch in Zukunft nicht loswerden. Mit Witz und Tiefe geht es dabei auch um die gesellschaftlichen Folgen – von handgreiflichen Auseinandersetzungen mit Todesfolge bis zur heilenden Kraft des Singens.},
  abstractor   = {publisher},
  address      = {Graz, Wien, Berlin},
  author       = {Neuenkirchen, Andreas},
  country      = {Austria, Germany},
  isbn         = {9783701183265},
  keywords     = {austrian_committee},
  language     = {German},
  note         = {1},
  pages        = {235},
  publisher    = {Leykam-Buchverlag},
  series       = {leykam: Sachbuch},
  title        = {Völlig losgelöst  : wie Karaoke die Welt eroberte},
  type         = {bm},
  year         = {2025},
}

@dd{AC17456043,
  abstract_I   = {Das Ziel meiner Dissertation ist es, Einblicke sowie Erkenntnisse über die musikalischen Werke sowohl serbisch- als auch bosnisch-stämmiger (BIH ) internationaler Künstlerinnen zu vermitteln, welche mit ihrer Arbeit die stilistischen Grenzen im Bereich von Experimentellem, Pop, Punk/New Wave, Minimalismus sowie der Elektronischen Musik von 1970 bis heute erweitert und diese Musikgattungen miteinander kombiniert haben. Mein Hauptfokus liegt dabei auf den folgenden Musikerinnen: Milica Paranosic, Svjetlana Bukvich, Ana Milosavljevic, Alexandra Sladjana Milosevic und Lene Lovich, sowie die Aktionskünstlerin Marina Abramovic, welche eine wichtige Rolle in der Performance Art innehat. Der Fokus meiner Arbeit liegt in der Untersuchung, welche Einflüsse auf diese serbisch-/bosnisch-stämmigen Künstlerinnen/Grenzgängerinnen eingewirkt und welche unterschiedlichen Genres sie für ihre Musik verwendet haben. Ich beschäftige mich mit dem kulturellen Austausch, der durch die Beziehungen der fünf Künstlerinnen untereinander stattgefunden hat und mit internationalen Einflüssen und Inspirationen, wie etwa durch die Musik von internationalen Künstlerinnen wie Kate Bush, Lydia Lunch, Laurie Anderson und Nina Hagen. Dabei haben sich drei Hauptfragen herauskristallisiert: 1. Welche Aspekte der Vor- als auch der Nachkriegsgeschichte von Ex-Jugoslawien / Serbien haben die serbische Künstlerinnen- und Künstler-Szene beeinflusst? 2. Welche Bedeutung haben serbische Künstlerinnen im vielfältigen Crossover-Bereich? 3. Wie nutzen sie Musik, Literatur und Performance, um Geschichten zu erzählen ("storytelling")? Als Hauptforschungsmethoden wurden historische Forschung, Analyse sozialer Netzwerke, einschließlich Literatur und "Storytelling" eingesetzt. Allen interviewten Künstlerinnen wurden dazu die gleichen Fragen gestellt. Es folgt dann eine Analyse musikalischer Beispiele von serbisch-/BIH-stämmigen Künstlerinnen zur Veranschaulichung der Mischung von Genres und Kulturen, westlicher und europäischer Musik sowie diverser Kombinationen zwischen Balkan- und Popmusik: Milica Paranosic: "Kales, bre Andjo": one-woman multimedia show "Confessions";  Svjetlana Bukvich: "Before and after the tekke" for amplified violin, electronics, and voice;  Ana Milosavljevic: "Zajdi, zajdi" for viper violin and electronics; Alexandra Sladjana Milosevic: "Legalize freedom"; Lene Lovich: "Bird song", sowie Marina Abramovic's performance "Balkan baroque" werden dahingehend analysiert. Abschließend werden Beispiele für Musikstücke mit internationalen Einflüssen vorgestellt: Lydia Lunch: "Dust and shadow" zur Illustration einer verbalen Darbietung; Laurie Anderson: "O, superman"; Nina Hagen (with Lene Lovich): "Don't kill the animals" und  Kate Bush: "Rocket's tail". Zur Vorbereitung dieser Arbeit wurden seit 2017 Interviews mit den oben genannten Künstlerinnen geführt, in denen auf diese Musikbeispiele Bezug genommen wurde. Ich hoffe, dass meine Dissertation zur Schaffung einer Plattform für grenzüberschreitende Künstlerinnen aus dem ehemaligen Jugoslawien beitragen kann.},
  abstract_II  = {The aim of my dissertation is to provide insights and findings on the musical works of international artists of Serbian and Bosnian origin (BIH) who, through their work, have expanded the stylistic boundaries in the fields of experimental, pop, punk/new wave, minimalism and electronic music from 1970 to the present day and have combined these musical genres. My main focus is on the following musicians: Milica Paranosic, Svjetlana Bukvich, Ana Milosavljevic, Alexandra Sladjana Milosevic and Lene Lovich, as well as performance artist Marina Abramovic, who plays an important role in performance art. My work focuses on investigating the influences that have shaped these Serbian/Bosnian artists/border crossers and the different genres they have used for their music. I deal with the cultural exchange that took place through the relationships between the five artists and with international influences and inspirations, such as the music of international artists like Kate Bush, Lydia Lunch, Laurie Anderson and Nina Hagen. Three main questions emerged: 1. Which aspects of the pre- and post-war history of the former Yugoslavia/Serbia have influenced the Serbian art scene? 2. What significance do Serbian female artists have in the diverse crossover field? 3. How do they use music, literature and performance to tell stories (‘storytelling’)? The main research methods used were historical research and analysis of social networks, including literature and storytelling. All the artists interviewed were asked the same questions. This is followed by an analysis of musical examples by artists of Serbian/BIH origin to illustrate the mixture of genres and cultures, Western and European music, and various combinations of Balkan and pop music: Milica Paranosic: "Kales, bre Andjo": one-woman multimedia show “Confessions”;  Svjetlana Bukvich: "Before and after the tekke" for amplified violin, electronics, and voice;  Ana Milosavljevic: "Zajdi, zajdi" for viper violin and electronics; Alexandra Sladjana Milosevic: "Legalize freedom"; Lene Lovich: "Bird song", as well as Marina Abramovic's performance "Balkan baroque" will be analysed in this context. Finally, examples of music with international influences are presented: Lydia Lunch: "Dust and shadow" to illustrate a verbal performance; Laurie Anderson: "O, superman"; Nina Hagen (with Lene Lovich): "Don't kill the animals"; and Kate Bush: "Rocket's tail". In preparation for this work, interviews have been conducted with the above-mentioned artists since 2017, in which reference was made to these musical examples. I hope that my dissertation can contribute to the creation of a platform for cross-border artists from the former Yugoslavia.},
  abstract_I_language = {German},
  abstract_II_language = {English},
  address      = {Wien},
  author       = {Eder, Marina},
  author_supervisor = {Huber, Harald and Hornberger, Barbara},
  country      = {Austria},
  institution  = {Bergische Universität Wuppertal},
  keywords     = {austrian_committee},
  language     = {English},
  note         = {1, 4},
  pages        = {272},
  title        = {Border-crossing female artists between experimental & popular music since 1970 from Serbia and Bosnia-Herzegovina},
  type         = {dd},
  year         = {2024},
}

@bm{AC17458763,
  abstract     = {Er war Musiker, Plattenverkäufer, DJ, Konzertmanager und vieles mehr — ohne Edek Bartz ist die Wiener Popgeschichte der 70er- und 80er-Jahre nicht denkbar.1946 wird Edek Bartz in einem Lager in Kasachstan geboren, er wächst in Polen auf und zieht 1958 mit seiner Mutter nach Wien. Er erwirbt sich auf eigene Faust eine Bildung, die zur Grundlage einer einzigartigen Karriere werden soll: Als Musiker, Plattenverkäufer, DJ, Kulturmanager und Kurator ist Bartz über Jahrzehnte stets zum richtigen Zeitpunkt am richtigen Ort – etwa als Organisator der ersten Österreich-Konzerte von Jimi Hendrix, Frank Zappa oder Pink Floyd. Bartz begleitet Peter Alexander durch Deutschland und Falco nach Japan. Bartz erzählt in den Gesprächen, die der Journalist Klaus Nüchtern aufgezeichnet hat, auch von seiner Begegnung mit dem späteren Maler-Star Jean-Michel Basquiat oder von der unabsichtlichen Entführung des Edek Bartz durch Frank Sinatra.},
  abstractor   = {publisher},
  address      = {Salzburg},
  author       = {Bartz Edek, and Nüchtern, Klaus},
  country      = {Austria},
  isbn         = {9783701736300},
  keywords     = {austrian_committee},
  language     = {German},
  note         = {1},
  pages        = {171},
  publisher    = {Residenz Verlag},
  title        = {„Interessant, du, faktisch…“  : Edek Bartz und Wiens Aufbruch in die Pop-Moderne},
  type         = {bm},
  year         = {2025},
}

@bm{AC17458903,
  abstract     = {Zu allen Zeiten gab es das Populäre in der Musik. Doch die Möglichkeit, Töne und Klänge zu konservieren und dauerhaft verfügbar zu machen, revolutionierte und veränderte die Hör- und Konsumgewohnheiten der Menschen ab dem Ende des 19. Jahrhunderts. Die rasante Entwicklung technischer Massenkommunikationsmittel beschleunigte diesen Prozess zusätzlich. Zuvor war der Genuss populärer Musik mit dem Prozess ihrer Entstehung unmittelbar verbunden, nun beschallte sie Privatwohnungen und öffentliche Räume. Sie wurde zum festen Bestandteil des Alltags und prägte fortan die Kulturgeschichte des 20. Jahrhunderts. Doch: Wer waren die steirischen „Popstars“ des 20. Jahrhunderts? Was haben die „Comedian Harmonists“ mit der Steiermark zu tun? Was war die steirische Antwort auf Woodstock? Und: Gab es international erfolgreiche Künstler/innen abseits von „Opus“ und ihrem Welthit Live is Life? Die folgenden Streifzüge durch 100 Jahre populäre Musik in der Steiermark stellen ausgewählte Protagonistinnen und Protagonisten sowie Bands und Formationen, musikalische Genres sowie singuläre Ereignisse der steirischen Popmusikgeschichte in den Fokus. Vielstimmig reiht sich Bekanntes an weniger Bekanntes, mitunter Vergessenes und ermöglicht eine Auseinandersetzung – nicht zuletzt mit der eigenen popkulturellen Sozialisation.},
  abstractor   = {publisher},
  address      = {Graz},
  country      = {Austria},
  editor       = {Froihofer, Maria and Museum für Geschichte},
  isbn         = {9783903179769},
  keywords     = {austrian_committee},
  language     = {German},
  note         = {1},
  pages        = {200},
  publisher    = {Museum für Geschichte, Universalmuseum Joanneum},
  title        = {POP 1900-2000  : populäre Musik in der Steiermark},
  type         = {bm},
  year         = {2025},
}

@bt{AC17473932,
  abstract     = {Der britische Journalist Brian J. Robb nimmt in seiner großen Werkschau jede einzelne Platte genau unter die Lupe, angefangen mit Speak & Spell aus dem Jahr 1981 bis zum jüngsten Werk, dem 2023 erschienenen Album Memento Mori. Ausführlich beschreibt er den Entstehungsprozess der einzelnen Songs und geht detailliert auf die Umstände ein, unter denen die Aufnahmen jeweils stattfanden. Gleichzeitig ist »Depeche Mode – Alle Alben, alle Songs« eine veritable Bandbiografie, da Robb ergänzend zu den musikalischen Fakten stets die Ereignisse im Leben der Bandmitglieder im Blick behält. Von den düsteren Industrial-Einflüssen auf Black Celebration über den kommerziellen Durchbruch mit Music For The Masses und Violator, der emotionalen Achterbahnfahrt der Neunziger, die für Dave Gahan beinahe mit einer tödlichen Überdosis endete, bis zur Rückkehr als musikalische Innovatoren mit Alben wie Playing The Angel oder Spirit haben sich Depeche Mode stets mit den großen Themen des Lebens auseinandergesetzt – Liebe, Tod, Sex, Politik und Gesellschaft. Ihre Songs erzählen ihre Geschichte – und die Geschichte der Songs erzählt dieses brillant recherchierte Buch.},
  abstractor   = {publisher},
  address      = {Höfen},
  author       = {Robb, Brian J.},
  author_translator = {Fleischmann, Paul},
  country      = {Austria},
  edition      = {Deutsche Erstausgabe},
  isbn         = {9783854457947},
  keywords     = {austrian_committee},
  language     = {German},
  language_original = {English},
  note         = {1},
  pages        = {276},
  publisher    = {Koch International GmbH Hannibal Verlag},
  title        = {Depeche Mode  : alle Alben, alle Songs},
  type         = {bt},
  year         = {2025},
}

@bm{AC17476489,
  abstract     = {Nicht lange nach der Übernahme Österreichs durch das Deutsche Reich bestellten Verantwortliche der Wiener Stadtregierung bei Franz Schmidt eine repräsentative Komposition im Rahmen der Initiativen zur lückenlosen Verbreitung von nationalsozialistischer Ideologie. Der Name Franz Schmidt wurde so für alle Zeiten mit dem anmaßenden Werktitel „Deutsche Auferstehung" verbunden und führte zu genereller Ächtung seiner Werke und sogar seines Namens. Eine fundierte Meinung basiert auf der Kenntnis aller Details. Die vorliegende Studie strebt einen umfassenden Überblick an.},
  abstractor   = {publisher},
  address      = {Vienna},
  author       = {Gailit, Michael},
  country      = {Austria},
  isbn         = {9783950544411},
  keywords     = {austrian_committee},
  language     = {German},
  note         = {1, 4},
  pages        = {47},
  publisher    = {urtext.at},
  series       = {yourtext.at},
  title        = {Tod durch Auferstehung  : Franz Schmidt : ein Komponist im Fadenkreuz  : summary in English},
  type         = {bm},
  volume       = {6050},
  year         = {2025},
}

@dd{AC17480180,
  abstract_I   = {In 1967 Toru Takemitsu (1930 - 1996) commented on the sound of traditional Japanese instruments or ensembles as "rising vertically" and the sound of European originated music as "progressing horizontally". This observation may no longer be accurate today in 2024. However, taking his remark as an induction, the dissertation project attempts to explore to which extent today’s art music has appropriated features of the ‘vertical’ attributes of traditional Japanese music. The dissertation aims to fill a gap between conceptual discourse of works of music and the sound itself. The central research of this project is to find how the "vertical" traits of the sound are incorporated in the music of composers of younger generations born after World War II, but having some connections to traditional Japanese art music. The works of these composers are examined from the aspects of (1) timbre, observed the inclusion of noises, extended performance techniques and combinations of instruments, (2) time concept, examined in reference to the rests, rhythms, pulses, metres (if any), and (3) structure, analysed from the aspects of sections, repetitions, development, changes, patterns, etc. The composers’ thoughts on traditional Japanese music and Japanese culture in general are also explored. Selected works are by the following composers: Toshio Hosokawa, Johannes Schöllhorn, Misato Mochizuki, Peter Gahn, Carlo Forlivesi, and Dai Fujikura (in order of birth dates). The goal of the research was to find whether the musical elements, which were passed on throughout the centuries in the specific part of the world, can be traced today through the lapse of time and space.},
  abstract_II  = {1967 beschrieb Toru Takemitsu (1930 - 1996) den Klang traditioneller japanischer Instrumente oder Ensembles als „vertikal aufsteigend“ und den Klang europäischer Musik als „horizontal fortschreitend“. Diese Beobachtung trifft heute, im Jahr 2024, möglicherweise nicht mehr zu. Ausgehend von seiner Bemerkung wird in der vorliegenden Dissertation untersucht, inwieweit die heutige Kunstmusik Merkmale der „vertikalen“ Eigenschaften traditioneller japanischer Musik übernommen hat. Die Dissertation zielt darauf ab, eine Lücke zwischen dem konzeptuellen Diskurs über Musikwerke und dem Klang selbst zu schließen. Im Mittelpunkt dieses Projekts steht die Frage, wie die „vertikalen” Merkmale des Klangs in die Musik von Komponisten der jüngeren Generationen einfließen, die nach dem Zweiten Weltkrieg geboren wurden, aber dennoch eine Verbindung zur traditionellen japanischen Kunstmusik haben. Die Werke dieser Komponisten werden unter folgenden Gesichtspunkten untersucht: (1) Klangfarbe, unter Berücksichtigung der Einbeziehung von Geräuschen, erweiterten Spieltechniken und Instrumentenkombinationen, (2) Zeitkonzept, unter Bezugnahme auf Pausen, Rhythmen, Impulse, Metren (falls vorhanden) und (3) Struktur, analysiert unter den Gesichtspunkten Abschnitte, Wiederholungen, Entwicklung, Veränderungen, Muster usw.  Die Ansichten der Komponisten zu traditioneller japanischer Musik und japanischer Kultur im Allgemeinen werden ebenfalls beleuchtet. Ausgewählte Werke stammen von folgenden Komponisten: Toshio Hosokawa, Johannes Schöllhorn, Misato Mochizuki, Peter Gahn, Carlo Forlivesi und Dai Fujikura (in der Reihenfolge ihres Geburtsdatums). Das Ziel der Forschung war es, herauszufinden, ob die musikalischen Elemente, die über Jahrhunderte hinweg in diesem bestimmten Teil der Welt weitergegeben wurden, heute trotz des Zeit- und Raumunterschieds noch nachvollziehbar sind.},
  abstract_I_language = {English},
  abstract_II_language = {German},
  address      = {Wien},
  author       = {Ezaki, Atsuko},
  author_supervisor = {Schröder, Gesine and Fukunaka, Fuyuko},
  country      = {Austria},
  institution  = {Tokyo University of the Arts},
  keywords     = {austrian_committee},
  language     = {English},
  note         = {1, 4},
  pages        = {2 Bände ix, 728},
  title        = {The sound rising vertically : traits of Japanese art music and its impact on contemporary art music since the late 1960s},
  type         = {dd},
  year         = {2024},
}

@bm{AC17486346,
  abstract     = {Es ist das Jahr 1980 und die Welt befindet sich im Kalten Krieg. Osten und Westen scheinen unversöhnlich und die Atombomben nur einen Knopfdruck entfernt. Doch Herman Rarebell, Drummer der legendären Scorpions, kümmert das nicht. Er kifft mit Hippies in den USA, schüttelt Gorbatschow die Hand und begegnet auf seinen Touren Menschen, die überall das Gleiche wollen: Frieden. Seine Geschichte handelt nicht nur von einer Band, die Musikgeschichte schrieb, sondern auch von der Zeit, in der sie es tat. Eine Zeit, in der Mauern fielen, Feindschaften endeten und eine verheißungsvolle Zukunft begann. Eine wahre Geschichte von Liebe, Freiheit und Hoffnung, die beweist: Wir dürfen an den Weltfrieden glauben},
  abstractor   = {publisher},
  address      = {Wien},
  author       = {Rarebell, Herman},
  country      = {Austria},
  isbn         = {9783990018064},
  keywords     = {austrian_committee},
  language     = {German},
  pages        = {252},
  publisher    = {edition a GmbH},
  title        = {What about love  : wie ich mit den Scorpions fast den Weltfrieden verwirklichte ... und wie er wieder möglich wird},
  type         = {bm},
  year         = {2025},
}

@bm{AC17488576,
  abstract     = {A captivating and lively memoir of a life shaped by music, At Large―Behind the Camera with Brian Large begins in the ruins of war-torn London and from there takes the reader on a riveting odyssey around the globe. Through his camera lens, Brian Large immortalized historical performances of the most renowned singers, dancers, and musicians of the past half-century, bringing the magic of live presentations into the homes of millions. In this engaging bildungsroman, Large recounts his career with wisdom, warmth, and wit, presenting intimate and revelatory glimpses of an astounding cast of characters featuring Luciano Pavarotti, Mirella Freni, Plácido Domingo, Leonard Bernstein, Marilyn Horne, Igor Stravinsky, Leontyne Price, Carlos Kleiber, Birgit Nilsson, Georg Solti, Cecilia Bartoli, Benjamin Britten, Queen Elizabeth II, and Frank Zappa. Originally a concert pianist, Large switched careers, joined BBCTV2 at its founding, and continued to push the boundaries of what television could achieve by capturing the immediacy and emotion of the moment for viewers everywhere. His groundbreaking work includes award-winning productions such as the Centennial Ring at Bayreuth, the original Three Tenors from the Baths of Caracalla, the live broadcast of Tosca from Rome’s historic sites, and two decades of directing the Vienna Philharmonic’s beloved New Year’s Concerts. Written in collaboration with Jane Scovell, whose previous works include biographies with Elizabeth Taylor and Ginger Rogers, and a definitive biography of Oona O’Neill Chaplin, this memoir, with a foreword by Renée Fleming, is a must-read for music lovers and those interested in the history of video technology.},
  abstractor   = {publisher},
  address      = {Vienna},
  author       = {Large, Brian and Scovell, Jane},
  author_foreword = {Fleming, Renée},
  author_introduction = {Falcone, Mary Lou},
  country      = {Austria},
  isbn         = {9783991531272},
  keywords     = {austrian_committee},
  language     = {English},
  note         = {1},
  pages        = {496},
  publisher    = {Verlag für Moderne Kunst},
  title        = {At Large  : behind the camera with Brian Large},
  type         = {bm},
  year         = {2025},
}

@dd{AC17496638,
  abstract_I   = {Obwohl die Bedeutung von Objekten zunehmend ernst genommen und ihr Beitrag verstärkt in der musik-, sozial- und kulturwissenschaftlichen Forschung untersucht wird, fällt es nach wie vor schwer, ihr (Mit)Wirken an schöpferischen Prozessen zu fassen. Während individuelle und kollektive Prozesse sowie kognitive und soziale Dimensionen des herstellenden Tuns — auch beim Improvisieren und Komponieren von Musik intensiv untersucht werden, werden die beteiligten nicht-menschlichen Einheiten in der Regel lediglich als relevante rahmende Infrastruktur oder als verwendete Werkzeuge berücksichtigt. Als ,mitgestaltende' Entitäten finden sie hingegen wenig Beachtung. Hier schließt die vorliegende Untersuchung an, in der ich den Fragen nachgehe, wie menschliche und nichtmenschliche Aktant:innen beim Herstellen populärer Musik kooperieren bzw. wie ihre Interaktionen das Herstellen von populärer Musik mitformen. Um dies zu erfassen, nehme ich eine sozio-materielle Perspektive ein, die insbesondere auf der Akteur-Netzwerk-Theorie basiert. Die Erhebung der Musikproduktionsprozesse von 16 Musiker:innen mittels fokussierten Ethnographien oder Interviews bildet die Basis der Analyse. Im Rahmen der an die Grounded Theory angelehnten Auswertung lassen sich acht Themenfelder identifizieren, die das Mit- bzw. Zusammenwirken der unterschiedlichen Entitäten sichtbar machen: Der Arbeitsraum gewährleistet ein Setting für die Ausführung repetitiver und (un)gekonnter Tätigkeiten. Interaktionen an der Eingabe-Schnittstelle eröffnen den Blick auf körperliche und physische Begrenzungen, die für die Klanggestaltung gezielt genutzt und dank der Kooperation mit nichtmenschlichen Entitäten gar überschritten werden können. Der Fokus auf Praktiken des Erstellens, des Suchens und des Schneidens offenbart, dass die vollzogenen Handlungen nicht nur von der erfolgreichen Interaktion mit nichtmenschlichen Aktanten getragen werden, sondern sie regelrecht auf einer Beziehungsarbeit zu den Dingen basieren. Sichtbar wird in der detaillierten Betrachtung auch die bislang kaum thematisierte Notwendigkeit für administrative Tätigkeiten, die das Schaffen erleichtern und sichern. Zufälle und Fehler, die sich im Umgang mit nichtmenschlichen Entitäten immer auch ergeben, erzeugen Irritationen, die verarbeitet und manchmal produktiv genutzt werden. Das Vorgefertigt-Sein der Dinge erlaubt schließlich, zeitlich vorgelagerte, wie auch externe Herstellungsprozesse in die Situation hereinzuholen. Da sich dieses Potenzial am Ideal künstlerischer Autor:innenschaft reibt, ist der Umgang von Musiker:innen mit Vorgefertigtem an eine Positionierung gegenüber den im Feld bestehenden Erwartungen verknüpft. Die acht Themenfelder machen deutlich, wie nichtmenschliche Entitäten in Gestaltungsprozesse von Musik hineinwirken und somit die spezifische Gestalt des Endproduktes mitgestalten. Das auf den ersten Blick Kleine, Unaufgeregte, Mechanische und Eintönige vermag so eine Ebene im Schaffensprozess aufzuzeigen, die den Dingen jenen Platz zugesteht, den sie schon immer eingenommen haben.},
  abstract_II  = {Although the importance of objects in social and cultural activity is increasingly being taken seriously, it is still difficult to grasp their contribution to creative processes. While individual and collective processes, as well as cognitive and social dimensions of creative activity—including improvisation and composition—are intensively studied, the non-human entities involved are usually considered only as relevant framing infrastructure or as tools used. As 'co-creating' entities, however, they receive little attention. This is where the present study comes in, in which I explore how human and non-human actors cooperate in the production of popular music, and how their interactions help to shape the production of popular music. In order to capture this, I adopt a socio-material perspective, based in particular on actor-network theory. I studied the music production processes of 16 musicians through focused ethnographies and interviews. In the grounded theory-oriented analyses I identify eight thematic areas that visualise the cooperation and interaction of the different entities: the workspace provides a setting for the performance of repetitive and (un)skilled activities. Interactions at the input interface open up a view of bodily and physical limitations that can be used specifically for music creation and even transcended thanks to cooperation with non-human entities. The focus on creative practices, searching and editing reveals that the actions performed depend not only on successful interaction with nonhuman actors, but are also based on a relationship with things. The detailed examination also reveals the need for administrative activities that facilitate and secure creation, which has hardly been addressed so far. The coincidences and errors that occur when dealing with nonhuman entities generate irritations that have to be processed and sometimes used productively. Ultimately, the prefabricated nature of things makes it possible to introduce temporally upstream and external production processes into the situation. As this potential clashes with the ideal of artistic authorship, the way in which musicians deal with the prefabricated is linked to a positioning vis-å-vis existing expectations in the field. These eight themes illustrate how nonhuman entities influence the creative processes of music and thus help to shape the specific form of the final product. What appears at first glance to be small, unexciting, mechanical and monotonous can thus reveal a level in the creative process that allows things the place they have always occupied.},
  abstractor_I = {author},
  abstractor_II = {author},
  abstract_I_language = {German},
  abstract_II_language = {English},
  address      = {Linz},
  author       = {Duffner, Ludger Roman},
  author_supervisor = {Stahrenberg, Carolin and Zembylas, Tasos},
  country      = {Austria},
  institution  = {Anton Bruckner Privatuniversität},
  keywords     = {austrian_committee},
  language     = {German},
  note         = {1},
  pages        = {viii, 235},
  title        = {Von Tasten, Farben, Bugs und Sounds  : über Kooperationen von menschlichen und nichtmenschlichen Aktant:innen im Herstellen populärer Musik},
  type         = {dd},
  year         = {2024},
}

@bm{AC17519572,
  abstract     = {Das zweistimmige Singen in geselliger Runde oder für sich selbst hat in der niederösterreichischen Region Pielachtal, das auch als „Dirndltal“ bekannt ist, eine langjährige Tradition. Im vorliegenden 2. Teil des 14. Bandes der Reihe „Corpus Musicae Popularis Austriacae“ stellten Bernhard Gamsjäger und Walter Deutsch in der Region bekannte und anerkannte Sängerinnen und Sänger mit ihren Liedern vor. Mehr als 640 im Zuge der Forschung zusammengetragene Belege entwerfen ein unverwechselbares gesangliches Klangbild der Region. Angaben über die Herkunft sowie Verbreitung der Lieder kontextualisieren die Forschungsergebnisse.},
  abstractor   = {publisher},
  address      = {Wien},
  author       = {Gamsjäger, Bernhard and Deutsch, Walter},
  country      = {Austria},
  editor       = {Volkskultur Niederösterreich GmbH},
  isbn         = {9783205221845},
  keywords     = {austrian_committee},
  language     = {German},
  note         = {1, 4},
  pages        = {820},
  publisher    = {Böhlau-Verlag},
  title        = {Corpus musicae popularis Austriacae  : Gesamtausgabe der Volksmusik in Österreich in repräsentativer Auswahl // herausgegeben von Volkskultur Niederösterreich GmbH . 14 ; Volksmusik in Niederösterreich ; Pielachtal ; 2 ; Sängerinnen und Sänger mit ihren Liedern // Bernhard Gamsjäger und † Walter Deutsch},
